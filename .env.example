# ==============================================================================
# AuraLaunch / LitVM LiteForge Testnet Bot Configuration
# ==============================================================================
# CATATAN KEAMANAN / SECURITY NOTICE:
# - JANGAN PERNAH memasukkan Private Key dari wallet utama (Mainnet / Cold Wallet)!
# - Gunakan burner wallet atau testnet wallet khusus.
# - Pastikan file .env TIDAK di-commit ke Git (sudah masuk di .gitignore).
# ==============================================================================

# RPC URL LitVM LiteForge Testnet
RPC_URL=https://liteforge.rpc.caldera.xyz/http

# Chain ID LitVM LiteForge Testnet
CHAIN_ID=4441

# Private key wallet (Wajib diisi di .env pribadi, jangan share ke publik!)
PRIVATE_KEY=your_private_key_here

# Alamat Smart Contract Target / Launchpad Pool
LAUNCHPAD_CONTRACT=0xC623189CbA3ec0b5B46A0eBf593064a83b05F6d4

# Calldata / Method ID yang akan dipanggil (default: 0xa6f2ae3a untuk deposit/buy)
CALLDATA=0xa6f2ae3a

# Gas limit transaksi
GAS_LIMIT=180000

# Jumlah zkLTC per transaksi
AMOUNT_PER_TX=0.0001

# Total berapa kali transaksi akan dijalankan
TOTAL_TRANSACTIONS=10

# Rentang jeda acak antar transaksi (dalam detik)
MIN_DELAY_SEC=5
MAX_DELAY_SEC=15
